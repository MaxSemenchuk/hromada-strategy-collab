    "import-hromadas": "tsx -r dotenv/config scripts/import-hromadas-metadata.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.1",
    "typescript": "^5"
  }
}
