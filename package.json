{
  "name": "hromada-strategy-collab",
  "version": "0.1.0",
  "private": true,
  "description": "МСС candidate agreements for Ukrainian hromadas (theme · legal form); strategy NLP is one discovery signal among geo, complementary, explicit-ask, and network.",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "setup-hromadas": "tsx -r dotenv/config scripts/migrations/setup-hromadas-table.ts",
    "structure-hromada": "tsx -r dotenv/config scripts/structure-hromada-strategy.ts",
    "import-hromadas": "tsx -r dotenv/config scripts/import-hromadas-metadata.ts",
    "export-hromadas": "tsx -r dotenv/config scripts/export-hromadas.ts",
    "export-hromadas:snapshot": "tsx scripts/export-hromadas.ts --from-snapshot data/research-log/hromadas_full54.json",
    "enrich-portal-urls": "tsx scripts/enrich-portal-urls.ts",
    "ckan-search": "tsx scripts/retrieval/ckan-search.ts",
    "download-raw": "tsx scripts/retrieval/download-raw.ts",
    "fetch-mss-registry": "tsx scripts/retrieval/fetch-mss-registry.ts",
    "hromada-resources": "python3 scripts/analysis/build_hromada_resources.py",
    "fetch-dream": "python3 scripts/analysis/fetch_dream_priorities.py",
    "fetch-twinning": "python3 scripts/analysis/build_twinning_layer.py --fetch-only",
    "twinning": "python3 scripts/analysis/build_twinning_layer.py",
    "complementary-match": "python3 scripts/analysis/complementary_match.py",
    "extract-mss-intents": "python3 scripts/analysis/extract_mss_intents.py",
    "build-goals-hierarchy": "python3 scripts/analysis/build_goals_hierarchy.py",
    "enrich-operational": "python3 scripts/analysis/enrich_operational.py",
    "match": "python3 scripts/analysis/match.py",
    "export-matching-edges": "python3 scripts/analysis/export_edges.py",
    "donor-synergy": "python3 scripts/analysis/donor_synergy.py",
    "test-length-norm": "python3 scripts/analysis/test_length_norm.py",
    "test-known-pairs": "python3 scripts/analysis/test_known_pairs.py",
    "report-pin-corpus": "python3 scripts/analysis/report_pin_corpus.py",
    "priority-corpus-growth": "python3 scripts/analysis/priority_corpus_growth.py",
    "test-tracks": "python3 scripts/analysis/test_tracks.py",
    "test-mss-suggest": "python3 scripts/analysis/test_mss_suggest.py",
    "test-mss-candidate": "python3 scripts/analysis/test_mss_candidate.py",
    "basin-overlay-spike": "python3 scripts/analysis/basin_overlay_spike.py",
    "graph-pin-matching": "python3 scripts/analysis/build_pin_matching_graph.py",
    "build-matches-preview": "python3 scripts/analysis/build_matches_preview.py",
    "build-resources-preview": "python3 scripts/analysis/build_resources_preview.py"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.1",
    "typescript": "^5"
  }
}
