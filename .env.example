# NocoDB connection — SHARED with the w3i-ecosystem base (same CRM instance).
# Use the same NOCODB_URL / NOCODB_TOKEN / NOCODB_BASE_ID as the w3i-network project's .env.
NOCODB_URL=https://nocodb-production-9ea4.up.railway.app
NOCODB_TOKEN=your-nocodb-api-token
NOCODB_BASE_ID=your-nocodb-base-id

# Hromadas table (created by `yarn setup-hromadas`)
NOCODB_TABLE_HROMADAS=mjtetfuixggp5lg

# LLM for structuring raw strategy text (scripts/structure-hromada-strategy.ts)
# Gemini free tier is region-gated, needs Cloud billing enabled to be reliable.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
